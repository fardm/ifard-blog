{
	"schemaVersion": "0.1.0",
	"name": "IMDB",
	"behavior": "create",
	"noteContentFormat": "",
	"properties": [
		{
			"name": "type",
			"value": "movie",
			"type": "text"
		},
		{
			"name": "scoreImdb",
			"value": "{{schema:aggregateRating.ratingValue}}",
			"type": "number"
		},
		{
			"name": "length",
			"value": "{{schema:@Movie:duration |replace:\\\"/^PT/\\\":\\\"\\\" |replace:\\\"H\\\":\\\"h \\\" |replace:\\\"M\\\":\\\"m\\\" }}",
			"type": "text"
		},
		{
			"name": "director",
			"value": "{{selector:[data-testid=\\\"title-pc-principal-credit\\\"]:first-child a|unique|join}}",
			"type": "multitext"
		},
		{
			"name": "genre",
			"value": "{{schema:genre|join}}",
			"type": "multitext"
		},
		{
			"name": "year",
			"value": "{{schema:datePublished|split:\\\"-\\\"|slice:0,1}}",
			"type": "text"
		},
		{
			"name": "rating",
			"value": "",
			"type": "number"
		},
		{
			"name": "cover",
			"value": "",
			"type": "text"
		},
		{
			"name": "cover_self",
			"value": "",
			"type": "text"
		},
		{
			"name": "cover_source",
			"value": "{{schema:image}}",
			"type": "text"
		},
		{
			"name": "date",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "Movie",
			"type": "multitext"
		},
		{
			"name": "badge",
			"value": "",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		}
	],
	"triggers": [
		"/^https:\\/\\/www\\.imdb\\.com\\/title\\/tt\\d+(?!\\/reference\\/)(\\/[^\\s]*)?$/"
	],
	"noteNameFormat": "{{schema:name}}",
	"path": "Resources/Movies"
}